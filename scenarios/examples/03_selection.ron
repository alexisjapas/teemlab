        (pos: (-400.0, -400.0), component: 0, rate: 0.0, color: (0.46, 0.46, 0.52), radius: 22.0, solid: true),
        (pos: (-375.0, -375.0), component: 0, rate: 0.0, color: (0.46, 0.46, 0.52), radius: 22.0, solid: true),
