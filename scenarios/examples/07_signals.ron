// 07 · Signals — one emission substrate, two meanings.
//
// An agent can WRITE to the environment, not only read it (the symmetric of
// absorption), and a written component MEANS whatever the reading relation says it
// means (SIM Law 11 — a scent and a poison differ ONLY by the verb on the other side).
// A single photosynthetic BLOOM (a sessile alga — reliable energy, no foraging to
// muddy the picture) demonstrates both verbs on the same `emit`:
//   • SCENT (component 0) — `emit` + `sense`: a diffusing, decaying trail the colony
//     lays and could read back as a perception channel. This is the substrate for
//     COMMUNICATION; a hand-written brain does not act on it (a learned brain's job,
//     08), but you can watch it bloom and fade on the heatmap.
//   • TOXIN (component 1) — `emit` + `affect < 0`: the same emission verb, but this one
//     is FELT, not smelt. It barely diffuses and clears slowly, so where the colony
//     packs densest its waste ACCUMULATES and drains energy — the dose rises with
//     density, so the alga POISONS ITSELF (eutrophication). The destabiliser pole,
//     mirroring 06's restraint stabiliser. The effect is falsifiable and strong: with
//     the toxin the bloom is held to roughly HALF the standing crop it reaches without
//     it (~215 vs ~470 over 300 s), its densest patches dying back and recolonising.
//
// Watch (View ▸ Layers): the alga greens the arena, a Scent haze over it; the Toxin
// reddens where it is thickest, and those patches thin out — a blotchy, self-limited
// bloom held well below the space that is free.
(
    tick_hz: 64.0,
    arena_half_extent: 320.0,
    archetypes: [
        (
            name: "Bloom",
            color: (0.55, 0.75, 0.35),
            count: 30,
            radius: 7.0,
            reserve_max: 60.0,
            genotype: (
                max_speed: 0.0,
                vision_range: 30.0,
                vision_rays: 1.0,
                reproduction_threshold: 32.0,
                offspring_energy: 18.0,
                mutation_rate: 0.0,
                photosynthesis: 3.4,
                seed_dispersal: 26.0,
            ),
            brain: Sessile,
            mutable: (
                max_speed: false,
                agility: false,
                vision_range: false,
                vision_fov: false,
                reproduction_threshold: false,
                offspring_energy: false,
                mutation_rate: false,
                vision_rays: false,
                photosynthesis: false,
                seed_dispersal: false,
                brain_cost: false,
                act_cost: false,
            ),
        ),
    ],
    field_resolution: 220,
    components: [
        // Scent — a pheromone trail: spreads a little, fades over ~30 s.
        (name: "Scent", diffusion: 0.2, decay: 0.03),
        // Toxin — barely spreads, clears slowly, so it piles up under a dense patch.
        (name: "Toxin", diffusion: 0.12, decay: 0.03),
    ],
    field_relations: [
        // Bloom lays a SCENT it can sense (communication substrate, latent on a sessile brain)…
        (species: 0, component: 0, emit: 2.0, sense: true),
        // …and emits a TOXIN that poisons it where it grows dense (self-poisoning — halves the bloom).
        (species: 0, component: 1, emit: 2.5, affect: -4.0),
    ],
    seed: 5,
)
