// 02 · Meadow — producers that live on light.
//
// The base of every food web: a SESSILE plant (SIM Law 11 — just an agent with a
// `Sessile` brain and a `photosynthesis` gene, no special "flora" type). It cannot
// move or hunt; it gains energy passively from the sun, and once its reserve crosses
// the reproduction threshold it SEEDS a copy a short distance away (`seed_dispersal`).
// From a dozen founders a meadow spreads and then packs to a spatial carrying
// capacity — bounded here by SPACE alone (there is no scarce nutrient yet; that is
// 03). Energy in > energy out, so unlike 01 the population grows instead of dying.
//
// Watch: green spreads outward from the founders and fills the arena. A medium arena
// so the colonisation is legible.
(
    tick_hz: 64.0,
    arena_half_extent: 260.0,
    archetypes: [
        (
            name: "Weed",
            color: (0.35, 0.8, 0.42),
            count: 12,
            radius: 8.0,
            reserve_max: 45.0,
            genotype: (
                max_speed: 0.0,
                vision_range: 30.0,
                vision_rays: 1.0,
                reproduction_threshold: 30.0,
                offspring_energy: 20.0,
                mutation_rate: 0.0,
                photosynthesis: 3.5,
                seed_dispersal: 30.0,
            ),
            brain: Sessile,
            mutable: (
                max_speed: false,
                agility: false,
                vision_range: false,
                vision_fov: false,
                reproduction_threshold: false,
                offspring_energy: false,
                mutation_rate: false,
                vision_rays: false,
                photosynthesis: false,
                seed_dispersal: false,
                brain_cost: false,
                act_cost: false,
            ),
        ),
    ],
    seed: 7,
)
