// 02 · Meadow — producers, a scarce nutrient, and a real carrying capacity.
//
// The base of every food web, and the first complete resource economy. A SESSILE plant
// (SIM Law 11 — just an agent with a `Sessile` brain and a `photosynthesis` gene, no
// special "flora" type) lives on the sun and seeds a copy nearby once its reserve crosses
// the reproduction threshold. But turning light into energy is not free: it CONSUMES a
// NUTRIENT (Liebig's law of the minimum — `cost_law.metabolic_cost`). A few vents
// (`sources`) leak that nutrient into a diffusing FIELD (toggle View ▸ Layers → Nutrient
// heatmap); a plant ABSORBS it into a small store and draws it down to photosynthesise.
//
// So the meadow is bounded by the NUTRIENT, not by space: plants cluster into OASES around
// the vents and grow until the crowd draws the local field down faster than the vents
// refill it. The excess then cannot cover its photosynthetic draw, starves, and dies —
// recycling its store back to the field (`emit_at_death`) for the survivors. A clean,
// density-dependent CARRYING CAPACITY set by the source rate, with real turnover.
//
// Watch: green blooms around each vent, then holds at a steady standing crop as births at
// the fringe balance starvation deaths in the crowded centre.
(
    tick_hz: 64.0,
    arena_half_extent: 340.0,
    archetypes: [
        (
            name: "Weed",
            color: (0.35, 0.8, 0.42),
            count: 24,
            radius: 6.0,
            reserve_max: 50.0,
            genotype: (
                max_speed: 0.0,
                vision_range: 30.0,
                vision_rays: 1.0,
                reproduction_threshold: 25.0,
                offspring_energy: 15.0,
                mutation_rate: 0.0,
                photosynthesis: 7.0,
                seed_dispersal: 22.0,
            ),
            brain: Sessile,
            mutable: (
                max_speed: false,
                agility: false,
                vision_range: false,
                vision_fov: false,
                reproduction_threshold: false,
                offspring_energy: false,
                mutation_rate: false,
                vision_rays: false,
                photosynthesis: false,
                seed_dispersal: false,
                brain_cost: false,
                act_cost: false,
            ),
        ),
    ],
    // Metabolic cost > 0: photosynthesis now draws down the nutrient (component 0). This is
    // the world constant that makes the nutrient a survival resource (Liebig), so the meadow
    // is nutrient-bounded with real turnover rather than carpeting the arena.
    cost_law: (size_exponent: 2.0, maintenance: 0.04, locomotion: 0.02, maneuver: 0.0002, metabolic_cost: 0.25),
    field_resolution: 256,
    components: [
        // `initial`: a uniform background stock of nutrient laid over the whole arena at
        // t=0, so plants everywhere can photosynthesise from the first tick while the vents'
        // gradients build up (instead of the map-wide starvation the empty field caused). A
        // uniform field is stationary under diffusion → a one-time WARM-UP reserve, drawn
        // down by absorption, not a sustained supply: the long-run carrying capacity is still
        // set by the vents (oases), the seed only smooths the opening seconds.
        (name: "Nutrient", diffusion: 0.3, decay: 0.0, initial: 0.1),
    ],
    sources: [
        (pos: (-150.0, 120.0), component: 0, rate: 16.0, color: (1.0, 0.55, 0.2), radius: 12.0),
        (pos: (160.0, 100.0), component: 0, rate: 16.0, color: (1.0, 0.55, 0.2), radius: 12.0),
        (pos: (0.0, -160.0), component: 0, rate: 16.0, color: (1.0, 0.55, 0.2), radius: 12.0),
    ],
    field_relations: [
        // Absorb the nutrient into a store, draw it down to photosynthesise (metabolic_cost),
        // and recycle what remains at death. Reproduction is energy-gated (no nutrient cost):
        // the nutrient limits SURVIVAL (photosynthesis), the energy threshold limits breeding.
        (species: 0, component: 0, absorb: 2.5, capacity: 10.0, emit_at_death: 5.0),
    ],
    // Founders are born holding a random fraction of their nutrient store (not empty), so
    // the opening cohort can photosynthesise at once and the first starvation wave is
    // staggered rather than synchronised — the in-body counterpart of the field's `initial`.
    random_initial_nutrients: true,
    seed: 7,
)
