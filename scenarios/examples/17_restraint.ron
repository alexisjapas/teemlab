// Restraint as a stability lever — the PAYOFF of the cognitive substrate.
//
// The substrate just built (proprioception + deliberate, costed eating,
// docs/persistent-ecosystems.md §2) made behavioural RESTRAINT *expressible*. This
// scenario + its driver (tests/restraint.rs) demonstrate its ecological value with the
// project's deterministic-control method (validate the pressure on a hand-written brain
// before asking a learned one to discover it, §4.2/§8): the `Grazer` is to restraint
// what the `Hunter` is to foraging — it forages identically but gates its eating on its
// own hunger (proprioception, self_state energy), so a *prudent* grazer leaves food
// uneaten.
//
// Two foragers, SAME body and economy, differ ONLY in *when they eat* (the Grazer's
// `hunger_threshold`):
//   • GREEDY  (1.0) eats whatever is in range — it drains flora even when full;
//   • PRUDENT (0.6) eats only until two-thirds full, then abstains — its time-averaged
//     footprint on the flora is ~its metabolic need, so it leaves the patch alive.
// They graze the same oasis flora; reproduction is co-gated on the NUTRIENT harvested by
// eating (like predator_prey — a shared overshoot cap bounded by the sources, applied
// EQUALLY to both, so it does not differentiate them). The appetite gate is the only
// difference.
//
// Two robust results the driver makes falsifiable:
//   (A) RESTRAINT IS A STABILITY LEVER — a PRUDENT monoculture persists and its flora
//       thrives, where a GREEDY monoculture overshoots and COLLAPSES to extinction. Same
//       body, same economy: the appetite gate alone separates a living ecosystem from a
//       dead one (§2's firm claim).
//   (B) TRAGEDY OF THE COMMONS — in THIS mixed world greed is individually superior
//       (eats more → harvests more nutrient → more offspring), so it OUT-COMPETES
//       prudence; the greed-dominated system then boom-busts. Restraint stabilises, but
//       it is not individually selected. This is the scene you watch: crimson (greedy)
//       displaces teal (prudent), then overshoots its own flora.
//
// What would make restraint SELECTABLE (so it *evolves*) is spatial viscosity strong
// enough that a lineage inherits the patch it preserved or exhausted (§2). The
// `seed_dispersal` gene is set local here, but with mobile foragers adult roaming
// homogenises impact and swamps it — closing that gap (near-immobile foragers, isolated
// patches) is §2's open hypothesis, deferred (ROADMAP §9).
(
    tick_hz: 64.0,
    arena_half_extent: 540.0,
    archetypes: [
        (
            name: "Greedy",
            color: (0.9, 0.32, 0.36),
            count: 16,
            radius: 8.0,
            reserve_max: 120.0,
            genotype: (
                max_speed: 50.0,
                agility: 0.12,
                vision_range: 140.0,
                vision_fov_deg: 130.0,
                // Energy bar for reproduction — kept BELOW the prudent hunger ceiling
                // (0.6 × 120 = 72) so a prudent grazer can still reproduce (restraint is
                // costly, not suicidal). Overshoot is capped by the nutrient gate below.
                reproduction_threshold: 55.0,
                offspring_energy: 30.0,
                mutation_rate: 0.0,
                vision_rays: 7.0,
                photosynthesis: 0.0,
                // Spatial viscosity — offspring born close (15 u). The *direction* §2
                // needs for restraint to become selectable, but not sufficient with
                // mobile foragers (adult roaming swamps it) — §2's open hypothesis,
                // deferred (ROADMAP §9). NON-mutable.
                seed_dispersal: 15.0,
                brain_cost: 0.0,
                // Reproduction also needs NUTRIENT, harvested ONLY by eating flora
                // (absorption 0 → trophic transfer). The Liebig cap that prevents
                // overshoot (its supply is bounded by the sources), exactly as in
                // predator_prey — applied identically to greedy and prudent.
                // FREE eating: isolate the appetite gate + dispersal as the only
                // variables (act_cost would add an individual penalty to greed).
                act_cost: 0.0,
            ),
            // GREEDY: eats whatever is in range (energy fraction always ≤ 1.0) — the
            // hunter's reflex. Drains flora even when full → destroys its patch.
            brain: Grazer(
                hunger_threshold: 1.0,
            ),
            mutable: (
                max_speed: false,
                agility: false,
                vision_range: false,
                vision_fov: false,
                reproduction_threshold: false,
                offspring_energy: false,
                mutation_rate: false,
                vision_rays: false,
                photosynthesis: false,
                seed_dispersal: false,
                brain_cost: false,
                act_cost: false,
            ),
        ),
        (
            name: "Prudent",
            color: (0.3, 0.8, 0.75),
            count: 16,
            radius: 8.0,
            reserve_max: 120.0,
            genotype: (
                max_speed: 50.0,
                agility: 0.12,
                vision_range: 140.0,
                vision_fov_deg: 130.0,
                reproduction_threshold: 55.0,
                offspring_energy: 30.0,
                mutation_rate: 0.0,
                vision_rays: 7.0,
                photosynthesis: 0.0,
                seed_dispersal: 15.0,
                brain_cost: 0.0,
                act_cost: 0.0,
            ),
            // PRUDENT: eats only while below 60 % full, then abstains — its
            // time-averaged draw on the flora is ~its metabolic need, so it leaves the
            // patch alive. 0.6 sits above the reproduction fill (55/120 ≈ 0.46), so it
            // still reproduces — restraint is individually costly, not suicidal.
            brain: Grazer(
                hunger_threshold: 0.6,
            ),
            mutable: (
                max_speed: false,
                agility: false,
                vision_range: false,
                vision_fov: false,
                reproduction_threshold: false,
                offspring_energy: false,
                mutation_rate: false,
                vision_rays: false,
                photosynthesis: false,
                seed_dispersal: false,
                brain_cost: false,
                act_cost: false,
            ),
        ),
        // Base of the chain — a flora that reseeds only where the nutrient field is
        // rich, so it clusters into OASES around the sources (patchy food = spatial
        // structure). The commons the two foragers share; a lightly grazed oasis
        // recovers (prudence pays), a stripped one goes locally bald (greed hurts).
        (
            name: "Flora",
            color: (0.4, 0.85, 0.4),
            count: 190,
            radius: 6.0,
            reserve_max: 80.0,
            genotype: (
                max_speed: 0.0,
                agility: 0.12,
                vision_range: 30.0,
                vision_fov_deg: 120.0,
                reproduction_threshold: 60.0,
                offspring_energy: 30.0,
                mutation_rate: 0.0,
                vision_rays: 1.0,
                photosynthesis: 5.0,
                seed_dispersal: 25.0,
                brain_cost: 0.0,
                act_cost: 0.0,
            ),
            brain: Sessile,
            mutable: (
                max_speed: false,
                agility: false,
                vision_range: false,
                vision_fov: false,
                reproduction_threshold: false,
                offspring_energy: false,
                mutation_rate: false,
                vision_rays: false,
                photosynthesis: false,
                seed_dispersal: false,
                brain_cost: false,
                act_cost: false,
            ),
        ),
    ],
    field_resolution: 256,
    components: [
        (
            name: "Nutrient",
            diffusion: 0.3,
            decay: 0.0,
        ),
    ],
    sources: [
        (
            pos: (-240.0, 240.0),
            component: 0,
            rate: 20.0,
            color: (1.0, 0.55, 0.2),
            radius: 12.0,
        ),
        (
            pos: (240.0, 240.0),
            component: 0,
            rate: 20.0,
            color: (1.0, 0.55, 0.2),
            radius: 12.0,
        ),
        (
            pos: (-240.0, -240.0),
            component: 0,
            rate: 20.0,
            color: (1.0, 0.55, 0.2),
            radius: 12.0,
        ),
        (
            pos: (240.0, -240.0),
            component: 0,
            rate: 20.0,
            color: (1.0, 0.55, 0.2),
            radius: 12.0,
        ),
    ],
    field_relations: [
        (species: 0, component: 0, absorb: 0.0, capacity: 30.0, repro_cost: 8.0),
        (species: 1, component: 0, absorb: 0.0, capacity: 30.0, repro_cost: 8.0),
        (species: 2, component: 0, absorb: 1.5, capacity: 8.0, repro_cost: 8.0),
    ],
    speed_bounds: (
