// Pheromones — component EMISSION + SENSING: an evolvable communication substrate.
//
// The first use-case of component emission (docs/component-emission-plan.md §3; the
// symmetric of absorption): agents WRITE a component into the environment and PERCEIVE
// it. The MLP foragers of the oasis (as in deliberate-eating) additionally EMIT a
// "Pheromone" component (a FieldRelation `emit`) that DIFFUSES into a gradient and
// DECAYS (fades) — a chemical trail — and SENSE its local concentration (`sense: true`)
// as an extra MLP input channel (Perception.field_state, appended after proprioception,
// the exact threat/proprioception wiring). A toxin and a pheromone differ ONLY by their
// relation (Law 11): this one is sensed, not `affect`-ed.
//
// DEMONSTRATED: the substrate — toggle the Pheromone heatmap (View ▸ Layers) to watch
// the trails bloom around the foragers and fade. The falsifiable proof that the sensed
// concentration reaches the decision is the unit test `mlp_reads_field_state_channel`.
// NOT claimed: that these from-random MLPs EVOLVE to communicate (coordinated signalling
// is neuroevolution-hard, ROADMAP §7) — the scene persists on the oasis (the honest §7
// target); making communication *emerge* is a research follow-on. Driver:
// tests/pheromones.rs (the population persists AND the pheromone field is written).
(
    tick_hz: 64.0,
    arena_half_extent: 480.0,
    archetypes: [
        (
            name: "MLP",
            color: (0.8, 0.45, 1.0),
            count: 80,
            radius: 8.0,
            reserve_max: 120.0,
            genotype: (
                max_speed: 130.0,
                agility: 0.12,
                vision_range: 170.0,
                vision_fov_deg: 130.0,
                reproduction_threshold: 50.0,
                offspring_energy: 22.0,
                mutation_rate: 0.15,
                base_metabolism: 4.0,
                move_cost: 2.0,
                vision_rays: 7.0,
                photosynthesis: 0.0,
                seed_dispersal: 0.0,
                brain_cost: 0.0,
                agility_cost: 0.02,
                act_cost: 1.5,
            ),
            brain: Mlp(
                hidden: [10],
            ),
            mutable: (
                max_speed: true,
                agility: true,
                vision_range: true,
                vision_fov: true,
                reproduction_threshold: true,
                offspring_energy: true,
                mutation_rate: false,
                base_metabolism: false,
                move_cost: false,
                vision_rays: true,
                photosynthesis: false,
                seed_dispersal: false,
                brain_cost: false,
                agility_cost: false,
                act_cost: false,
            ),
        ),
        // Patchy food — a flora that reseeds only where the nutrient field is rich, so
        // it clusters into oases around the sources.
        (
            name: "Flora",
            color: (0.4, 0.85, 0.4),
            count: 220,
            radius: 6.0,
            reserve_max: 80.0,
            genotype: (
                max_speed: 0.0,
                agility: 0.12,
                vision_range: 30.0,
                vision_fov_deg: 120.0,
                reproduction_threshold: 60.0,
                offspring_energy: 30.0,
                mutation_rate: 0.0,
                base_metabolism: 1.0,
                move_cost: 0.0,
                vision_rays: 1.0,
                photosynthesis: 7.0,
                seed_dispersal: 25.0,
                brain_cost: 0.0,
                agility_cost: 0.0,
                act_cost: 0.0,
            ),
            brain: Sessile,
            mutable: (
                max_speed: false,
                agility: false,
                vision_range: false,
                vision_fov: false,
                reproduction_threshold: false,
                offspring_energy: false,
                mutation_rate: false,
                base_metabolism: false,
                move_cost: false,
                vision_rays: false,
                photosynthesis: false,
                seed_dispersal: false,
                brain_cost: false,
                agility_cost: false,
                act_cost: false,
            ),
        ),
    ],
    relations: [
        (
            actor: 0,
            target: 1,
            transfer: true,
            rate: 45.0,
            range: 16.0,
        ),
    ],
    field_resolution: 256,
    components: [
        // Component 0 — the nutrient (as in the other oasis scenarios): fed by the
        // sources, absorbed by the flora, conserved (no decay).
        (
            name: "Nutrient",
            diffusion: 0.3,
            decay: 0.0,
        ),
        // Component 1 — the PHEROMONE: emitted by the foragers (no source), spreads a
        // little (diffusion) and FADES (decay) so a trail is transient, not permanent.
        (
            name: "Pheromone",
            diffusion: 0.2,
            decay: 0.05,
        ),
    ],
    sources: [
        (
            pos: (-220.0, 220.0),
            component: 0,
            rate: 14.0,
            color: (1.0, 0.55, 0.2),
            radius: 12.0,
        ),
        (
            pos: (220.0, 220.0),
            component: 0,
            rate: 14.0,
            color: (1.0, 0.55, 0.2),
            radius: 12.0,
        ),
        (
            pos: (-220.0, -220.0),
            component: 0,
            rate: 14.0,
            color: (1.0, 0.55, 0.2),
            radius: 12.0,
        ),
        (
            pos: (220.0, -220.0),
            component: 0,
            rate: 14.0,
            color: (1.0, 0.55, 0.2),
            radius: 12.0,
        ),
    ],
    field_relations: [
        // The forager (species 0) eats flora → nutrient (component 0), gated on it.
        (species: 0, component: 0, absorb: 0.0, capacity: 30.0, repro_cost: 8.0),
        // …and EMITS + SENSES the pheromone (component 1): it lays a trail (emit) and
        // reads the local concentration as an MLP input (sense) — the communication
        // substrate. No cost to emit in v1 (a later `act_cost`-style price is optional).
        (species: 0, component: 1, emit: 2.0, sense: true),
        // The flora (species 1) absorbs the nutrient to reproduce (oases).
        (species: 1, component: 0, absorb: 1.5, capacity: 8.0, repro_cost: 8.0),
    ],
    speed_bounds: (
        min: 40.0,
        max: 280.0,
    ),
    agility_bounds: (
