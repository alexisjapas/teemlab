// 10 · Reef — space and structure: rocks, rooted kelp, and turnover.
//
// The physical/spatial levers, composed into one scene. Two features beyond the
// trophic economy of 04:
//   • ROCKS are SOLID sources (a static collider that emits nothing): they block bodies
//     and occlude vision, carving a sheltered, winding reef — spatial refugia. A pure
//     rock has `rate: 0` and `solid: true`.
//   • KELP is a sessile plant ANCHORED to the substrate by a spring (`anchor`): it roots
//     where it seeds, is jostled and springs back, but pulled past its breaking TENSION
//     (`stiffness · displacement`) it is UPROOTED and dies (`die_on_detach`), leaving
//     DETRITUS (a second component). Two things uproot it — a grazer ramming it to feed,
//     and its own crowding — so uprooting is a portable, physical TURNOVER: the mortality
//     lever a standing-crop carrying capacity needs (cf. 03).
//
// The trophic economy is 04's, inside the shelter: kelp on the sun + nutrient vents, a
// light grazer that dominates and eats it (emergent targeting), breeding on the nutrient
// it harvests. Watch (View ▸ Layers): kelp clusters into oases around the vents inside
// the rocks; grazers weave through the gaps (rocks occlude and block them); a Detritus
// patch blooms and fades where kelp is torn loose. A lively example to watch, not a
// steady state (ROADMAP §7).
(
    tick_hz: 64.0,
    arena_half_extent: 460.0,
    archetypes: [
        (
            name: "Kelp",
            color: (0.30, 0.75, 0.50),
            count: 140,
            radius: 7.0,
            reserve_max: 50.0,
            genotype: (
                max_speed: 0.0,
                vision_range: 30.0,
                vision_rays: 1.0,
                reproduction_threshold: 22.0,
                offspring_energy: 13.0,
                mutation_rate: 0.0,
                photosynthesis: 6.5,
                seed_dispersal: 20.0,
            ),
            brain: Sessile,
            mutable: (
                max_speed: false,
                agility: false,
                vision_range: false,
                vision_fov: false,
                reproduction_threshold: false,
                offspring_energy: false,
                mutation_rate: false,
                vision_rays: false,
                photosynthesis: false,
                seed_dispersal: false,
                brain_cost: false,
                act_cost: false,
            ),
            // A spring of stiffness 30 holds each kelp to its seed point; it snaps once the
            // tension (stiffness · displacement) exceeds 700 — a ~23-unit pull (radius 7, so
            // ~three body-widths). Jostling holds; a grazer's shove or a packed clump tears
            // it loose → death → detritus (turnover).
            anchor: Some((stiffness: 30.0, damping: 3.0, tear_force: 700.0, die_on_detach: true)),
        ),
        (
            name: "Grazer",
            color: (1.0, 0.55, 0.35),
            count: 4,
            radius: 8.0,
            reserve_max: 120.0,
            genotype: (
                max_speed: 105.0,
                agility: 0.12,
                vision_range: 130.0,
                vision_fov_deg: 130.0,
                reproduction_threshold: 120.0,
                offspring_energy: 42.0,
                mutation_rate: 0.06,
                vision_rays: 7.0,
            ),
            brain: Hunter,
            mutable: (mutation_rate: false),
        ),
    ],
    predation: (size_margin: 0.1, range: 20.0, rate: 16.0),
    field_resolution: 256,
    components: [
        (name: "Nutrient", diffusion: 0.3, decay: 0.0),
        // Detritus lingers (low diffusion) and slowly fades (decay) — an uprooting leaves
        // a visible, localized patch that decomposes over time.
        (name: "Detritus", diffusion: 0.06, decay: 0.02),
    ],
    sources: [
        // Rocks (solid, emitting nothing) carve the reef.
        (pos: (-170.0, 130.0), component: 0, rate: 0.0, color: (0.46, 0.46, 0.52), radius: 34.0, solid: true),
        (pos: (140.0, 165.0), component: 0, rate: 0.0, color: (0.46, 0.46, 0.52), radius: 30.0, solid: true),
        (pos: (200.0, -60.0), component: 0, rate: 0.0, color: (0.46, 0.46, 0.52), radius: 28.0, solid: true),
        (pos: (40.0, -190.0), component: 0, rate: 0.0, color: (0.46, 0.46, 0.52), radius: 32.0, solid: true),
        (pos: (-180.0, -150.0), component: 0, rate: 0.0, color: (0.46, 0.46, 0.52), radius: 30.0, solid: true),
        (pos: (-20.0, -10.0), component: 0, rate: 0.0, color: (0.40, 0.40, 0.46), radius: 22.0, solid: true),
        // Nutrient vents (intangible) the kelp clusters around, tucked into the shelter.
        (pos: (-110.0, -80.0), component: 0, rate: 28.0, color: (1.0, 0.55, 0.2), radius: 11.0),
        (pos: (90.0, 40.0), component: 0, rate: 28.0, color: (1.0, 0.55, 0.2), radius: 11.0),
        (pos: (-40.0, 150.0), component: 0, rate: 28.0, color: (1.0, 0.55, 0.2), radius: 11.0),
    ],
    field_relations: [
        // Kelp: absorbs & holds the nutrient, seeds on it, deposits detritus at death.
        (species: 0, component: 0, absorb: 2.0, capacity: 8.0, emit_at_death: 5.0, repro_cost: 6.0),
        (species: 0, component: 1, emit_at_death: 5.0),
        // Grazer: needs the nutrient (kelp digestible), harvests by eating, breeds on it;
        // a grazer corpse also returns some detritus.
        (species: 1, component: 0, capacity: 30.0, emit_at_death: 3.0, repro_cost: 16.0, need: 1.0),
        (species: 1, component: 1, emit_at_death: 3.0),
    ],
    play_area_color: (0.05, 0.09, 0.12),
    off_game_color: (0.10, 0.14, 0.18),
    seed: 0,
)
