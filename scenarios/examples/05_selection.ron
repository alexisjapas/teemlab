// 05 · Selection — a trait is kept only where it pays.
//
// Natural selection made legible (SIM Law 7 — every characteristic is priced). The
// foragers here are WANDERERS: they drift at random and eat whatever they blunder
// into (a Wander brain holds its eat intent on, but it cannot STEER toward what it
// sees). So their VISION is pure overhead — a real metabolic cost (range × rays) that
// buys them nothing, since they never act on it. Selection duly MELTS the eyes down:
// the founders start far-sighted (range 200, 9 rays) and, generation after generation,
// the population's vision genes slide toward their floor.
//
// Watch the gene-drift curves in the HUD: vision range and ray count fall, while the
// traits that DO pay (speed, reproduction) hold. The contrast is the whole lesson —
// give these same eyes to a Hunter that uses them (04) and they are kept. Underneath,
// a self-regulating economy: the flora is nutrient-bounded and grazing recycles it, so
// the world stays alive long enough for selection to act.
(
    tick_hz: 64.0,
    arena_half_extent: 360.0,
    archetypes: [
        (
            name: "Wanderer",
            color: (1.0, 0.5, 0.4),
            count: 12,
            radius: 8.0,
            reserve_max: 120.0,
            genotype: (
                max_speed: 140.0,
                agility: 0.12,
                vision_range: 200.0,
                vision_fov_deg: 120.0,
                reproduction_threshold: 90.0,
                offspring_energy: 45.0,
                mutation_rate: 0.08,
                vision_rays: 9.0,
            ),
            brain: Wander(turn_rate: 0.25),
            mutable: (
                mutation_rate: false,
            ),
        ),
        (
            name: "Flora",
            color: (0.4, 0.85, 0.4),
            count: 160,
            radius: 6.0,
            reserve_max: 50.0,
            genotype: (
                max_speed: 0.0,
                vision_range: 30.0,
                vision_rays: 1.0,
                reproduction_threshold: 22.0,
                offspring_energy: 14.0,
                mutation_rate: 0.0,
                photosynthesis: 6.0,
                seed_dispersal: 24.0,
            ),
            brain: Sessile,
            mutable: (
                max_speed: false,
                agility: false,
                vision_range: false,
                vision_fov: false,
                reproduction_threshold: false,
                offspring_energy: false,
                mutation_rate: false,
                vision_rays: false,
                photosynthesis: false,
                seed_dispersal: false,
                brain_cost: false,
                act_cost: false,
            ),
        ),
    ],
    // A low floor so the useless eyes have room to slide all the way down.
    vision_range_bounds: (min: 30.0, max: 320.0),
    // A gentler world than the default cost law: a lower metabolic floor lets a
    // clumsy random forager survive between meals, so the population persists across
    // seeds and selection has generations to work with (the cost is scenario data).
    cost_law: (size_exponent: 2.0, maintenance: 0.022, locomotion: 0.015, maneuver: 0.0002),
    predation: (size_margin: 0.1, range: 20.0, rate: 20.0),
    field_resolution: 256,
    components: [
        (name: "Nutrient", diffusion: 0.3, decay: 0.0),
    ],
    sources: [
        (pos: (-220.0, 220.0), component: 0, rate: 24.0, color: (1.0, 0.55, 0.2), radius: 12.0),
        (pos: (220.0, 220.0), component: 0, rate: 24.0, color: (1.0, 0.55, 0.2), radius: 12.0),
        (pos: (-220.0, -220.0), component: 0, rate: 24.0, color: (1.0, 0.55, 0.2), radius: 12.0),
        (pos: (220.0, -220.0), component: 0, rate: 24.0, color: (1.0, 0.55, 0.2), radius: 12.0),
    ],
    field_relations: [
        // Wanderer: needs the nutrient (flora is digestible), holds it, breeds on it.
        (species: 0, component: 0, capacity: 30.0, emit_at_death: 3.0, repro_cost: 8.0, need: 1.0),
        // Flora: absorbs & holds the nutrient, seeds on it, recycles at death.
        (species: 1, component: 0, absorb: 1.5, capacity: 8.0, emit_at_death: 5.0, repro_cost: 6.0),
    ],
    seed: 1,
)
