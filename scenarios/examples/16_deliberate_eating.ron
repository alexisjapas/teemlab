// Deliberate eating — the interaction primitive becomes a COSTED, brain-driven choice.
//
// The second half of the cognitive substrate (docs/persistent-ecosystems.md §2; the
// first was proprioception). Until now eating fired automatically on every target in
// range — predation was a reflex. Here the MLP DECIDES whether to eat (its 3rd output,
// Action.act, gated in `interact`) and holding that intent COSTS energy (gene
// `act_cost`, charged in `metabolize` — SIM Law 7). So indiscriminate "always eat"
// bleeds energy, and the brains selection keeps are those that GATE their eating —
// holding the intent near food / when hungry (weighing the proprioceptive self-state,
// item "proprioception"), releasing it otherwise. Restraint becomes *expressible*.
//
// A living population evolving on patchy oasis flora (as in mlp_train), but with the
// eating cost switched on. Open the inspector to watch an agent's `act` output in the
// network graph toggle as it forages. An EXAMPLE to watch — the population persists on
// the oasis over the observation window (it does not collapse); on living food the
// long-horizon outcome is Lotka–Volterra (ROADMAP §7), not a flat steady state.
(
    tick_hz: 64.0,
    arena_half_extent: 480.0,
    archetypes: [
        (
            name: "MLP",
            color: (0.8, 0.45, 1.0),
            count: 80,
            radius: 8.0,
            reserve_max: 120.0,
            genotype: (
                max_speed: 130.0,
                agility: 0.12,
                vision_range: 170.0,
                vision_fov_deg: 130.0,
                reproduction_threshold: 50.0,
                offspring_energy: 22.0,
                mutation_rate: 0.15,
                base_metabolism: 4.0,
                move_cost: 2.0,
                vision_rays: 7.0,
                photosynthesis: 0.0,
                seed_dispersal: 0.0,
                brain_cost: 0.0,
                agility_cost: 0.02,
                nutrient_absorption: 0.0,
                nutrient_capacity: 30.0,
                offspring_nutrient: 8.0,
                // The eating cost — the point of this scenario. Energy/s while the
                // eat/attack intent is held (Action.act > 0). Modest against the ~45
                // eating rate and the 4.0 base metabolism: enough that holding the
                // intent everywhere is wasteful (restraint pays), not so much that a
                // competent forager cannot make eating net-positive. NON-mutable (it is
                // the selection pressure, like the other costs) — the gating evolves in
                // the brain (the `act` output), not by zeroing the gene.
                act_cost: 1.5,
            ),
            brain: Mlp(
                hidden: [10],
            ),
            mutable: (
                max_speed: true,
                agility: true,
                vision_range: true,
                vision_fov: true,
                reproduction_threshold: true,
                offspring_energy: true,
                mutation_rate: false,
                base_metabolism: false,
                move_cost: false,
                vision_rays: true,
                photosynthesis: false,
                seed_dispersal: false,
                brain_cost: false,
                agility_cost: false,
                nutrient_absorption: false,
                nutrient_capacity: false,
                offspring_nutrient: false,
                act_cost: false,
            ),
        ),
        // Patchy food — a flora that reseeds only where the nutrient field is rich, so
        // it clusters into oases around the sources (as in mlp_train).
        (
            name: "Flora",
            color: (0.4, 0.85, 0.4),
            count: 220,
            radius: 6.0,
            reserve_max: 80.0,
            genotype: (
                max_speed: 0.0,
                agility: 0.12,
                vision_range: 30.0,
                vision_fov_deg: 120.0,
                reproduction_threshold: 60.0,
                offspring_energy: 30.0,
                mutation_rate: 0.0,
                base_metabolism: 1.0,
                move_cost: 0.0,
                vision_rays: 1.0,
                photosynthesis: 7.0,
                seed_dispersal: 25.0,
                brain_cost: 0.0,
                agility_cost: 0.0,
                nutrient_absorption: 1.5,
                nutrient_capacity: 8.0,
                offspring_nutrient: 8.0,
                act_cost: 0.0,
            ),
            brain: Sessile,
            mutable: (
                max_speed: false,
                agility: false,
                vision_range: false,
                vision_fov: false,
                reproduction_threshold: false,
                offspring_energy: false,
                mutation_rate: false,
                base_metabolism: false,
