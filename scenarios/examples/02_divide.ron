            ),
            brain: Hunter,
            mutable: (mutation_rate: false),
            spawn_zone: Some((shape: Circle(center: (147.0, -147.0), radius: 180.0))),
        ),
        (
            // Producers — the UPPER-LEFT half's food base only.
            name: "Producer",
            color: (0.35, 0.8, 0.42),
            count: 110,
            radius: 6.0,
            reserve_max: 50.0,
            genotype: (
                max_speed: 0.0,
